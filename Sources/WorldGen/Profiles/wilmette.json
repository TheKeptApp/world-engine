  "provenance": {
    "comment": "Documentation only; the profile decoder ignores this object. Fields not listed here are unmeasured proposal values.",
    "trees.canopyShare": {
      "status": "measured",
      "value": 0.55,
      "measuredValue": 0.551,
      "source": "USDA NAIP 2023 leaf-on, 0.3 m, 4 bands (public domain; credit: NAIP imagery provided by USDA Farm Service Agency). NDVI plus near-infrared texture canopy mask; value = canopy share of the area's built fabric (land without parks of at least 1,000 m2 and without water). Tools/regionkit/aerial/canopy_areas.py, results in Tools/regionkit/aerial/results/canopy_areas.json; docs/research/aerial.md section 13.",
      "area": "Data/areas/wilmette-vattmann-park (1 km2)",
      "acquired": "2023-07-10",
      "check": "50 photo-interpreted points: 0.476 (0.33-0.62); mask vs points agree 74 %. An earlier 0.25 km2 study cell gave 0.58.",
      "date": "2026-10-06"
    },
    "trees.heightMeters": {
      "status": "measured",
      "value": [11.8, 19.4],
      "measuredValue": {"p25": 11.8, "p75": 19.38, "trees": 3229, "basis": "detected trees at least 7 m high"},
      "previous": [11, 19],
      "source": "USGS 3DEP lidar, EPT USGS_LPC_IL_4County_Cook_2017_LAS_2019 (project IL_4_County_QL1_LiDAR_2016_B16; public domain; credit: U.S. Geological Survey, 3D Elevation Program). Vegetation-class canopy height model at 1 m (height above class-2 ground), roof, wall and wire clutter removed, tree tops by height-adaptive local maxima, crowns by watershed. value = p25 and p75 of the detected trees at least 7 m high, i.e. the trees the generator draws from heightMeters after its youngShare draw. Tools/regionkit/lidar/trees.py, results in Tools/regionkit/lidar/results/trees.json; docs/research/lidar-roofs.md section Tree heights.",
      "area": "Data/areas/wilmette-vattmann-park (1 km2)",
      "acquired": "2017-04-16 to 2017-05-07 (leaf-off: tops of bare crowns, probably 0.5-1 m low; about 9 years of growth since the flight not included)",
      "check": "3,684 trees (36.8 per ha), heights p10/p25/p50/p75/p90 = 6.5/9.9/14.7/18.9/21.9 m for all detected trees (p25-p75 of all trees would be 9.9-18.9). 12 validation crops: 10 single trees, 2 ambiguous (a low mound, a columnar conifer), 0 non-trees. p25 9.1-10.9 and p75 18.3-19.2 m over 11 one-at-a-time detection settings (all trees). Lidar tree cover 0.40 (crown plan area) against NAIP 0.55: the leaf-off crowns are sparser.",
      "date": "2026-10-06"
    },
    "trees.youngShare": {
      "status": "measured",
      "value": 0.12,
      "measuredValue": 0.1235,
      "previous": 0.18,
      "source": "As trees.heightMeters. value = share of detected trees below 7 m (455 of 3,684; median 5.7 m).",
      "area": "Data/areas/wilmette-vattmann-park (1 km2)",
      "acquired": "2017-04-16 to 2017-05-07 (leaf-off)",
      "check": "0.082-0.150 over the detection settings. Leaf-off lidar sees small sparse trees less well (probably biased low); shrubs of 3-7 m count as trees (biased high). youngHeightMeters [3, 6] is unchanged: the measured young trees have median 5.7 m, but trees under 4 m are poorly detected, so the data do not settle it.",
      "date": "2026-10-06"
    }
  }
