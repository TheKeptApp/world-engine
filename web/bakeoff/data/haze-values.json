{
  "pack": "haze-visibility-v1",
  "definition": {
    "visibilityConvention": "meteorological_optical_range_5_percent",
    "contrastThreshold": 0.05,
    "constant": 2.995732273553991,
    "sigmaFormula": "sigmaPerM = -ln(0.05)/(1000*visibilityKm)",
    "inverseFormula": "visibilityKm = -ln(0.05)/(1000*sigmaPerM)",
    "transmittance": "T=exp(-tau), tau=integral(sigma(s) ds); homogeneous tau=sigmaPerM*distanceM",
    "radiance": "CoutLinear=T*ClitLinear+(1-T)*CairLinear for homogeneous constant airlight; layered airlight requires front-to-back radiance integration",
    "legacy2Percent": "Old weather-moments visibilityEquivalentM uses approximately 3.912/sigma (2% contrast). Recompute from actual sigma with 2.995732/sigma for this pack; never relabel unchanged numbers."
  },
  "airlight": {
    "stateDayHex": {
      "clear": "#BDD0D9",
      "hazy": "#C3CED4",
      "humid": "#CCD2CD",
      "smoke": "#B1AA9A",
      "rain": "#A1ADB0",
      "snow": "#B9C7D0"
    },
    "timeHex": {
      "blueHour": "#8294AE",
      "night": "#475568",
      "goldenHour": "#C4C3B6"
    },
    "timeMix": {
      "day": 0,
      "blueHour": 1,
      "night": 1,
      "goldenHour": 0.35
    },
    "mix": "Decode day and time hex; mix in linear light using timeMix. Prefer physically lit directional sky/horizon radiance when supported. These are authored palette fallbacks, not spectral scattering data.",
    "distanceTint": "Distance changes T only; no additional distance desaturation or second fog grade. At tau .1 mix9.52%, tau .5 mix39.35%, tau1 mix63.21%, tau3 mix95.02%. Silhouettes approach actual directional airlight, not saturated blue or white. Night lighting changes airlight, not sigma just because it is dark.",
    "preserveCalibration": "Exposure, matte materials, saturation and warm direct sunlight remain calibration-v2. No local lamps added to global airlight."
  },
  "mountains": {
    "retainRule": "Require real map/DEM position and unoccluded curved-earth sightline; cloud/stratus may cut off summits. Compute linear luminance horizon contrast C0=abs(Ymountain-Yair)/max(Yair,0.001); retainedContrast=C0*T. Keep silhouette when retainedContrast>=0.05 and projected height>=2px. Simplify internal detail below 0.10 contrast; fade/cull geometry below0.03, with smooth transition across0.03\u20130.05. Thresholds are phone authoring targets, not guaranteed human visual acuity.",
    "nominalContrast": 0.5,
    "retainContrast": 0.05,
    "cullContrast": 0.03,
    "internalDetailContrast": 0.1,
    "minProjectedHeightPx": 2,
    "important": "MOR is not a hard clip plane. A mountain may be obscured closer than MOR because initial contrast is lower than a black test target. Peaks above a boundary haze layer can remain visible; integrate actual ray through layers rather than applying ground visibility uniformly to every altitude.",
    "nominalMaxDistance": "dMax=ln(C0/0.05)/sigma; for C0=.5 dMax=.7686*V (same distance units)",
    "geography": "Sloan lake west view has Front Range; east downtown view has no mountains behind downtown. Never invent mountain positions.",
    "earthRadiusM": 6371000,
    "curvature": "Use geocentric terrain/rays for20\u2013100km; no flat-earth horizon. Refraction off unless validated model.",
    "lod": "20km relief/major folds;50km silhouette + large lit planes;100km simplified horizon. Actual projected size and contrast decide, not arbitrary mountain boost.",
