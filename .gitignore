# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/
/Packages/

# Xcode (project files are generated by XcodeGen; never commit them)
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcresult

# Tools built locally (e.g. pinned XcodeGen)
Tools/.build/

# Scratch
*.tmp

# Visual reference images (never commit)
reference/

# Machine-local settings (signing team ID etc.), never committed
.local/

# Instruments traces (large)
*.trace/

# Generated repro project
Apps/PostProcessRepro/*.xcodeproj/

# Generated assets (converted DogWell dog, world packages) and web build output
Generated/
web/node_modules/
web/dist/

# Raw Simulator captures (the 16:9 gate crops and composites are committed)
docs/screenshots/*/raw/
# Device runs set aside (charging / Low Power Mode)
docs/perf/*/discarded/
