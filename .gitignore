# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/
/Packages/

# Xcode (project files are generated by XcodeGen; never commit them)
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcresult

# Tools built locally (e.g. pinned XcodeGen)
Tools/.build/

# Scratch
*.tmp

# Visual reference images (never commit)
reference/

# Machine-local settings (signing team ID etc.), never committed
.local/

# Instruments traces (large)
*.trace/

# Generated repro project
Apps/PostProcessRepro/*.xcodeproj/

# Generated assets (converted DogWell dog, world packages) and web build output
Generated/
web/node_modules/
web/dist/

# Raw Simulator captures (the 16:9 gate crops and composites are committed)
docs/screenshots/*/raw/
# Device runs set aside (charging / Low Power Mode)
docs/perf/*/discarded/

# Design-pack images stay in the local checkout, not in git (owner, 2026-10-06).
# README.md, *.json and prompt files in docs/proposals are still committed. Already-committed images stay in history.
docs/proposals/**/*.png
docs/proposals/**/*.jpg
docs/proposals/**/*.jpeg
docs/proposals/**/*.zip
# SVGs over 1 MB (gitignore cannot match by size; list them, add new ones as packs land)
docs/proposals/postcards-widgets-v1/images/frame-bold-portrait.svg
docs/proposals/postcards-widgets-v1/images/frame-bold-square.svg
docs/proposals/postcards-widgets-v1/images/frame-bold-story.svg
docs/proposals/postcards-widgets-v1/images/frame-classic-portrait.svg
docs/proposals/postcards-widgets-v1/images/frame-classic-square.svg
docs/proposals/postcards-widgets-v1/images/frame-classic-story.svg
docs/proposals/postcards-widgets-v1/images/frame-minimal-portrait.svg
docs/proposals/postcards-widgets-v1/images/frame-minimal-square.svg
docs/proposals/postcards-widgets-v1/images/frame-minimal-story.svg
docs/proposals/postcards-widgets-v1/images/postcard-01.svg
docs/proposals/postcards-widgets-v1/images/postcard-02.svg
docs/proposals/postcards-widgets-v1/images/postcard-03.svg
docs/proposals/postcards-widgets-v1/images/postcard-04.svg
docs/proposals/postcards-widgets-v1/images/postcard-05.svg
docs/proposals/postcards-widgets-v1/images/postcard-06.svg
docs/proposals/postcards-widgets-v1/images/widgets-clear.svg
docs/proposals/postcards-widgets-v1/images/widgets-rain.svg

# Look loop: frames, contact sheets and the overview stay local; scoreboard, summary, regressions, grades and the daily sheet are committed.
docs/lookloop/latest/frames/
docs/lookloop/latest/sheets/
docs/lookloop/latest/*.jpg
docs/lookloop/daily/baseline-*/

# Device logs stay local (owner, 2026-10-06)
*.devicelog

# Paint-over input frames stay local (owner, 2026-10-06)
docs/lookloop/paintover-input/*.png
docs/lookloop/paintover-input/*.jpg

# paintover-v1 SVGs are all over 1 MB (owner rule, 2026-10-06)
docs/proposals/paintover-v1/images/*.svg
