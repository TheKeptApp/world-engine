  "policy": {
    "colourSpace": "sRGB swatches decode to linear RGB before blending; encode once at output",
    "formula": "C_linear = sum(fraction_i * srgbToLinear(palette_i)); fractions >= 0 and sum = 1 after area-weighted reprojection",
    "seasonBlend": "Interpolate corresponding class colours in linear RGB using local phenology state; calendar only fallback. Crop stage and water state have separate masks.",
    "snowOverlay": "Base class fractions*(1-snowFraction) plus snow_ice*snowFraction; snowFraction from actual supported coverage, not all winter ground",
    "unknownData": "Neutral inherited class palette; do not invent species, irrigation, crop type or shoreline changes",
    "resolution": "Area-weighted land-cover fractions in equal-area space before reprojection; blend ecotones by coverage, not state/metro boundaries",
    "continents": "Same palettes/fractions at region and continent, coarser polygons; no separate vivid continent tint",
    "wetness": "Weather material response applies once after seasonal base colour; no albedo shadow bake",
    "night": "Use unchanged street-to-space night appearance palette/state as the documented fallback; do not multiply day seasonal colours by arbitrary night tint or add duplicate exposure",
    "minimumFeaturePolicy": "Under 6 drawable pixels aggregate/cull; preserve source water connectivity until unresolved, never widen roads or rivers artificially"
  },
