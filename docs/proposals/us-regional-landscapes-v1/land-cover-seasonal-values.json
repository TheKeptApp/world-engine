  "cropStagePolicy": "Per crop/elevation/water mask: bare -> emergent -> green -> ripe (only appropriate crop, e.g. cereal) -> harvested stubble. Different crops may be harvested green; winter crops may stay green in calendar winter. Seasonal regional cropland hex is an aggregate fallback, never a crop calendar.",
  "dataSelectionPolicy": {
    "order": [
      "Source terrain/hydrography/land use",
      "Mapped habitat/ecoregion/local species",
      "Observed crop/phenology/water/snow state",
      "Regional fallback proposal"
    ],
    "noGlobalRegionalCoverageAssumption": true,
    "noInventedIndividuals": true,
    "fieldGeometry": "Preserve observed polygons, mapped pivot shape and drainage; do not stamp a grid or circle from region name",
    "smallTownPlacement": "Only source settlement/building footprint; proposed facade family never creates houses in wilderness",
    "wetlands": "Use freshwater/saline/hydroperiod masks; flooding overrides broad calendar colour",
    "dateFallback": "Calendar seasons only when local phenology unavailable; identify fallback as inferred"
  }
}
