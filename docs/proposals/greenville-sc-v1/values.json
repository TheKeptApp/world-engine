  "districts": [
    {
      "id": "07-downtown",
      "description": "District with tree-lined two-lane Main Street, attached 2\u20135-storey brick storefront blocks transitioning to terraced river park with shallow rock cascade and GENERIC slender curved pedestrian bridge shell over Reedy-like river. Not exact Liberty Bridge reproduction, no monuments/public art. Street left, aerial center shows park linkage, far right rolling urban setting.",
      "surveyed": false
    },
    {
      "id": "08-north-main",
      "description": "Leafy residential district with 1920s bungalows, Craftsman houses and modest infill, mature broad oaks, gently rolling streets, front porches, 18\u201325m lots and 6\u201310m setbacks, no enormous mountains.",
      "surveyed": false
    },
    {
      "id": "09-augusta-road",
      "description": "District inspired by residential streets around Augusta Road: brick ranches, bungalows and selective two-storey homes, generous oak-shaded yards and rolling grades, small blank neighborhood storefront cluster near main corridor; not North Augusta.",
      "surveyed": false
    },
    {
      "id": "10-mill-village",
      "description": "Compact textile mill-village district, small repeating gable cottages with individual variations, front porches and modest lawns on rolling lanes; distant generic red-brick former mill shell, no named landmark or chimney text.",
      "surveyed": false
    }
