{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Builder AI race operations rules",
  "type": "object",
  "required": [
    "schemaVersion",
    "checked",
    "rules",
    "sizeProfiles",
    "gates",
    "requiredInputs",
    "heat"
  ],
  "properties": {
    "schemaVersion": {
      "const": "race-organizer-ops.v1"
    },
    "checked": {
      "type": "string",
      "format": "date"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "unit",
          "status",
          "scope",
          "sourceIds",
          "checked",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "assumption",
              "unverified"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "checked": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "sizeProfiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "runners",
          "toilets",
          "accessibleToilets",
          "toiletClusters",
          "required",
          "status"
        ],
        "properties": {
          "runners": {
            "enum": [
              500,
              2000,
              10000
            ]
          },
          "toilets": {
            "type": "integer",
            "minimum": 1
          },
          "accessibleToilets": {
            "type": "integer",
            "minimum": 1
          },
          "toiletClusters": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "gates": {
      "type": "object"
    },
    "requiredInputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heat": {
      "type": "object",
      "required": [
        "approvedThresholdsC",
        "autonomousGoNoGo"
      ],
      "properties": {
        "approvedThresholdsC": {
          "type": "null"
        },
        "autonomousGoNoGo": {
          "const": false
        }
      }
    }
  }
}