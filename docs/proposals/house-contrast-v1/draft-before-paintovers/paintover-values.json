  "definitions": {
    "hex": "sRGB display appearance swatches under unchanged daylight; not material albedo or measured source pixels",
    "relativeBrightness": "linear Rec.709 luminance Y, normalized to the wall of the same house type = 1",
    "linearLuminance": "sRGB decoded to linear RGB, Y=0.2126R+0.7152G+0.0722B",
    "shadowPolicy": "Appearance targets, not additional multiply layers. Preserve source sunlight and fill; reconcile with existing AO (fill-only visibility floor 0.65).",
    "palettePolicy": "Representative variants, not universal Chicago colors; preserve observed material identity and mapped tags."
  },
