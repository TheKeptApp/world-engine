{
  "comment": "Overture building heights vs USGS 3DEP lidar heights (heights.py). Area = a committed test area (read-only). Every threshold below was set before any Overture-vs-lidar comparison was run (only lidar point counts and the byte plan had been looked at). Distances in metres, areas in m^2 (plan). The EPT is the same public usgs-lidar-public dataset as pilot.json (anonymous HTTPS, not requester-pays); only octree nodes whose horizontal extent meets the area box (plus a margin) are read.",
  "area": "Data/areas/wilmette-vattmann-park",
  "overtureFile": "overture-buildings.json",
  "marginMeters": 15,
  "ept": {
    "root": "https://s3-us-west-2.amazonaws.com/usgs-lidar-public/USGS_LPC_IL_4County_Cook_2017_LAS_2019/",
    "dataset": "USGS_LPC_IL_4County_Cook_2017_LAS_2019",
    "acquired": "2017-04 to 2017-05 (flight, per the dataset name and the pilot's FGDC check)",
    "maxDepth": 10,
    "budgetBytes": 200000000,
    "nodeBudgetBytes": 170000000
  },
  "points": {"roofClass": 6, "groundClass": 2},
  "align": {"cell": 0.5, "searchMeters": 3.0},
  "shiftMinHeightAboveGround": 2.0,
  "minHeightAboveGround": 1.0,
  "groundCell": 5.0,
  "footprintErosion": 0.5,
  "minFootprintM2": 15,
  "groundRing": {"innerM": 3.0, "outerM": 8.0, "wideOuterM": 15.0, "minPoints": 8},
  "eaveBand": {"fromEdgeM": 0.5, "toEdgeM": 2.0, "percentile": 15, "minPoints": 10},
  "topPercentile": 95,
  "cover": {"cell": 0.5, "fillDist": 1.0},
  "minBuildingPoints": 20,
  "minRoofCover": 0.5,
  "noBuildingMaxCover": 0.1,
  "tolerance": {"within": 1.5, "lowOverture": 6.0, "highLidar": 7.5},
  "strataAreaM2": [45, 90],
  "strataNames": ["under45", "45to90", "90plus"],
  "heightBinsM": [0, 3, 4, 5, 6, 7, 8, 9, 100],
  "floors": {"perFloor": 3.0, "perFloorSensitivity": [2.8, 3.2], "riseCapM": 5.0, "defaultFallbackFloors": 2, "minFloors": 1},
  "rules": {"dropBelowM": [6.0, 7.0, 8.0], "dropHouseBelowM": 7.5, "houseMinAreaM2": 90, "offsetsM": [2.0, 3.0], "cvFolds": 5},
  "minGroupN": 5
}
